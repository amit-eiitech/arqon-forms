{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "eii/arqon-forms",
    "description": "A dynamic form builder and submission manager for Laravel 13 and Filament 5.",
    "keywords": ["laravel", "filament", "forms", "form-builder", "survey", "submissions"],
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/mail": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "illuminate/view": "^13.0",
        "filament/filament": "^5.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Arqon\\Forms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arqon\\Forms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Arqon\\Forms\\ArqonFormsServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
